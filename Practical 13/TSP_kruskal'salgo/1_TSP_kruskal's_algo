class DSU:
    def __init__(self, n):
        self.parent = list(range(n))
        self.rank = [0] * n

    def find(self, x):
        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]

    def union(self, a, b):
        ra, rb = self.find(a), self.find(b)
        if ra == rb:
            return False
        if self.rank[ra] < self.rank[rb]:
            self.parent[ra] = rb
        elif self.rank[ra] > self.rank[rb]:
            self.parent[rb] = ra
        else:
            self.parent[rb] = ra
            self.rank[ra] += 1
        return True


def kruskal_mst(n, edges):
    """edges = [(weight, u, v), ...]"""
    dsu = DSU(n)
    mst = [[] for _ in range(n)]
    edges.sort()

    for w, u, v in edges:
        if dsu.union(u, v):
            mst[u].append((v, w))
            mst[v].append((u, w))
    return mst


def dfs_tour(mst, start=0):
    visited = set()
    tour = []

    def dfs(u):
        visited.add(u)
        tour.append(u)
        for v, _ in mst[u]:
            if v not in visited:
                dfs(v)

    dfs(start)
    tour.append(start)  # return to start
    return tour


def tsp_kruskal(dist):
    n = len(dist)
    edges = []

    # Build edge list
    for i in range(n):
        for j in range(i + 1, n):
            edges.append((dist[i][j], i, j))

    mst = kruskal_mst(n, edges)
    tour = dfs_tour(mst)

    # Compute tour cost
    cost = 0
    for i in range(len(tour) - 1):
        cost += dist[tour[i]][tour[i + 1]]

    return tour, cost


# Example usage
distances = [
    [0, 2, 2, 5],
    [2, 0, 4, 6],
    [2, 4, 0, 8],
    [5, 6, 8, 0]
]

tour, cost = tsp_kruskal(distances)
print("Tour:", tour)
print("Cost:", cost)